// Import data/synthetic_shipments.csv as Shipments.
// Create total_cost_usd in Power Query by summing the five source cost fields.
// Create Calendar as shown in BUILD_GUIDE.md and relate it to ship_date.

Total Revenue =
SUM(Shipments[revenue_usd])

Total Cost =
SUM(Shipments[total_cost_usd])

Gross Profit =
[Total Revenue] - [Total Cost]

Gross Margin % =
DIVIDE([Gross Profit], [Total Revenue])

Shipment Count =
DISTINCTCOUNT(Shipments[shipment_id])

Total Miles =
SUM(Shipments[distance_miles])

Revenue per Mile =
DIVIDE([Total Revenue], [Total Miles])

Cost per Mile =
DIVIDE([Total Cost], [Total Miles])

Revenue per Shipment =
DIVIDE([Total Revenue], [Shipment Count])

On-Time Shipments =
CALCULATE([Shipment Count], Shipments[on_time] = 1)

On-Time % =
DIVIDE([On-Time Shipments], [Shipment Count])

Exception Shipments =
CALCULATE([Shipment Count], Shipments[service_exception] = 1)

Exception Rate =
DIVIDE([Exception Shipments], [Shipment Count])

Fuel Cost =
SUM(Shipments[fuel_cost_usd])

Driver Cost =
SUM(Shipments[driver_cost_usd])

Maintenance Cost =
SUM(Shipments[maintenance_cost_usd])

Tolls =
SUM(Shipments[tolls_usd])

Accessorial Cost =
SUM(Shipments[accessorial_cost_usd])

Rolling 3M Gross Margin % =
VAR Period =
    DATESINPERIOD('Calendar'[Date], MAX('Calendar'[Date]), -3, MONTH)
RETURN
    DIVIDE(CALCULATE([Gross Profit], Period), CALCULATE([Total Revenue], Period))

Prior Month Gross Profit =
CALCULATE([Gross Profit], DATEADD('Calendar'[Date], -1, MONTH))

Gross Profit MoM % =
DIVIDE([Gross Profit] - [Prior Month Gross Profit], [Prior Month Gross Profit])

Required Revenue at Target Margin =
VAR TargetMargin = SELECTEDVALUE('Margin Target'[Margin], 0.18)
RETURN
    DIVIDE([Total Cost], 1 - TargetMargin)

Revenue Gap to Target Margin =
[Required Revenue at Target Margin] - [Total Revenue]
